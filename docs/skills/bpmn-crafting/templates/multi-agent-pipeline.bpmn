<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_multi_agent_pipeline" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="multi_agent_pipeline" name="Multi-Agent Pipeline" isExecutable="true">
    <bpmn:documentation>Plan -&gt; Implement -&gt; Review sequential pipeline.</bpmn:documentation>
    <bpmn:startEvent id="Start_Pipeline" name="Task Ingested">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Plan" name="Plan Work">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="harness_type" value="pi_agent" />
          <camunda:property name="agent_role" value="planner" />
        </camunda:properties>
        <camunda:inputOutput>
          <camunda:inputParameter name="brief">${brief}</camunda:inputParameter>
          <camunda:outputParameter name="plan_status">${status}</camunda:outputParameter>
          <camunda:outputParameter name="plan_summary">${summary}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Implement" name="Implement Work">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="harness_type" value="pi_agent" />
          <camunda:property name="agent_role" value="implementer" />
        </camunda:properties>
        <camunda:inputOutput>
          <camunda:inputParameter name="plan">${plan_summary}</camunda:inputParameter>
          <camunda:outputParameter name="impl_status">${status}</camunda:outputParameter>
          <camunda:outputParameter name="impl_summary">${summary}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Review" name="Review Work">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="harness_type" value="pi_agent" />
          <camunda:property name="agent_role" value="reviewer" />
        </camunda:properties>
        <camunda:inputOutput>
          <camunda:inputParameter name="diff">${impl_summary}</camunda:inputParameter>
          <camunda:outputParameter name="review_status">${status}</camunda:outputParameter>
          <camunda:outputParameter name="review_summary">${summary}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Done" name="Pipeline Complete">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Pipeline" targetRef="Task_Plan" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Plan" targetRef="Task_Implement" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Implement" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Review" targetRef="End_Done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_multi_agent_pipeline">
    <bpmndi:BPMNPlane id="BPMNPlane_multi_agent_pipeline" bpmnElement="multi_agent_pipeline">
      <bpmndi:BPMNShape id="Start_Pipeline_di" bpmnElement="Start_Pipeline">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Plan_di" bpmnElement="Task_Plan">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Implement_di" bpmnElement="Task_Implement">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Review_di" bpmnElement="Task_Review">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Done_di" bpmnElement="End_Done">
        <dc:Bounds x="657" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="325" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="425" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="657" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
