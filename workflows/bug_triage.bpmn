<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_BugTriage" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="bug_triage" name="Interactive Bug Triage &amp; Fix" isExecutable="true">
    <bpmn:documentation>AI diagnoses bug reports and poses diagnostic questions, human engineer provides reproduction context, then AI resumes context to generate a verified fix.</bpmn:documentation>
    <bpmn:startEvent id="Start_Bug" name="Bug Reported">
      <bpmn:outgoing>Flow_To_Diagnose</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_To_Diagnose" sourceRef="Start_Bug" targetRef="Task_Diagnose" />
    <bpmn:serviceTask id="Task_Diagnose" name="Diagnose &amp; Pose Questions">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="harness_type" value="pi_agent" />
          <camunda:property name="agent_role" value="bug_analyst" />
        </camunda:properties>
        <camunda:inputOutput>
          <camunda:inputParameter name="bug_report">${bug_report}</camunda:inputParameter>
          <camunda:outputParameter name="diagnose_status">${status}</camunda:outputParameter>
          <camunda:outputParameter name="diagnose_summary">${summary}</camunda:outputParameter>
          <camunda:outputParameter name="diagnose_findings">${findings}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Diagnose</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Diag_GW</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_To_Diag_GW" sourceRef="Task_Diagnose" targetRef="GW_Diag_Check" />
    <bpmn:exclusiveGateway id="GW_Diag_Check" name="Diagnosis OK?">
      <bpmn:incoming>Flow_To_Diag_GW</bpmn:incoming>
      <bpmn:outgoing>Flow_Diag_Success</bpmn:outgoing>
      <bpmn:outgoing>Flow_Diag_Fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Diag_Success" name="Success" sourceRef="GW_Diag_Check" targetRef="Task_Human_Clarify">
      <bpmn:conditionExpression>diagnose_status == 'success'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Diag_Fail" name="Failed" sourceRef="GW_Diag_Check" targetRef="End_Bug_Fail">
      <bpmn:conditionExpression>diagnose_status != 'success'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Task_Human_Clarify" name="Clarify Bug Details">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="doc_preview" label="### Diagnosis &amp; Questions&#10;Review the AI root-cause analysis and question checklist." type="markdown" />
          <camunda:formField id="reproduction_notes" label="Reproduction Steps &amp; Clarifications" type="textarea" />
          <camunda:formField id="priority" label="Priority Level" type="string" defaultValue="high" />
          <camunda:formField id="proceed_with_fix" label="Proceed with Fix? (yes/no)" type="string" defaultValue="yes" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Diag_Success</bpmn:incoming>
      <bpmn:outgoing>Flow_Clarify_To_GW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Clarify_To_GW" sourceRef="Task_Human_Clarify" targetRef="GW_Fix_Decision" />
    <bpmn:exclusiveGateway id="GW_Fix_Decision" name="Proceed?">
      <bpmn:incoming>Flow_Clarify_To_GW</bpmn:incoming>
      <bpmn:outgoing>Flow_Proceed_Fix</bpmn:outgoing>
      <bpmn:outgoing>Flow_Decline_Fix</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Proceed_Fix" name="Yes" sourceRef="GW_Fix_Decision" targetRef="Task_Generate_Fix">
      <bpmn:conditionExpression>proceed_with_fix == 'yes'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Decline_Fix" name="No" sourceRef="GW_Fix_Decision" targetRef="End_Bug_Closed">
      <bpmn:conditionExpression>proceed_with_fix != 'yes'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_Generate_Fix" name="Generate Patch &amp; Test">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="harness_type" value="pi_agent" />
          <camunda:property name="agent_role" value="bug_fixer" />
        </camunda:properties>
        <camunda:inputOutput>
          <camunda:inputParameter name="bug_report">${bug_report}</camunda:inputParameter>
          <camunda:inputParameter name="diagnosis">${diagnose_summary}</camunda:inputParameter>
          <camunda:inputParameter name="reproduction_notes">${reproduction_notes}</camunda:inputParameter>
          <camunda:inputParameter name="priority">${priority}</camunda:inputParameter>
          <camunda:outputParameter name="fix_status">${status}</camunda:outputParameter>
          <camunda:outputParameter name="fix_summary">${summary}</camunda:outputParameter>
          <camunda:outputParameter name="fix_artifacts">${artifacts}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Proceed_Fix</bpmn:incoming>
      <bpmn:outgoing>Flow_Fix_To_GW</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Fix_To_GW" sourceRef="Task_Generate_Fix" targetRef="GW_Fix_Check" />
    <bpmn:exclusiveGateway id="GW_Fix_Check" name="Fix Generated?">
      <bpmn:incoming>Flow_Fix_To_GW</bpmn:incoming>
      <bpmn:outgoing>Flow_Fix_OK</bpmn:outgoing>
      <bpmn:outgoing>Flow_Fix_Fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Fix_OK" name="Success" sourceRef="GW_Fix_Check" targetRef="Task_Verify_Fix">
      <bpmn:conditionExpression>fix_status == 'success'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Fix_Fail" name="Failed" sourceRef="GW_Fix_Check" targetRef="End_Bug_Fail">
      <bpmn:conditionExpression>fix_status != 'success'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Task_Verify_Fix" name="Verify Patch">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="doc_preview" label="### Proposed Patch &amp; Verification&#10;Review the patch diff and test execution summary." type="markdown" />
          <camunda:formField id="signoff" label="Sign-off (approved/needs_work)" type="string" defaultValue="approved" />
          <camunda:formField id="notes" label="Engineer Notes" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Fix_OK</bpmn:incoming>
      <bpmn:outgoing>Flow_To_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_To_End" sourceRef="Task_Verify_Fix" targetRef="End_Bug_Closed" />
    <bpmn:endEvent id="End_Bug_Closed" name="Bug Resolved">
      <bpmn:incoming>Flow_To_End</bpmn:incoming>
      <bpmn:incoming>Flow_Decline_Fix</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Bug_Fail" name="Triage Failed">
      <bpmn:incoming>Flow_Diag_Fail</bpmn:incoming>
      <bpmn:incoming>Flow_Fix_Fail</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_BugTriage">
    <bpmndi:BPMNPlane id="BPMNPlane_BugTriage" bpmnElement="bug_triage">
      <bpmndi:BPMNShape id="Start_Bug_di" bpmnElement="Start_Bug">
        <dc:Bounds x="50" y="140" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Diagnose_di" bpmnElement="Task_Diagnose">
        <dc:Bounds x="140" y="118" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Diag_Check_di" bpmnElement="GW_Diag_Check" isMarkerVisible="true">
        <dc:Bounds x="320" y="133" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Human_Clarify_di" bpmnElement="Task_Human_Clarify">
        <dc:Bounds x="420" y="118" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Fix_Decision_di" bpmnElement="GW_Fix_Decision" isMarkerVisible="true">
        <dc:Bounds x="620" y="133" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Generate_Fix_di" bpmnElement="Task_Generate_Fix">
        <dc:Bounds x="720" y="118" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Fix_Check_di" bpmnElement="GW_Fix_Check" isMarkerVisible="true">
        <dc:Bounds x="920" y="133" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Verify_Fix_di" bpmnElement="Task_Verify_Fix">
        <dc:Bounds x="1020" y="118" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Bug_Closed_di" bpmnElement="End_Bug_Closed">
        <dc:Bounds x="1220" y="140" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Bug_Fail_di" bpmnElement="End_Bug_Fail">
        <dc:Bounds x="327" y="250" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_To_Diagnose_di" bpmnElement="Flow_To_Diagnose">
        <di:waypoint x="86" y="158" />
        <di:waypoint x="140" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_Diag_GW_di" bpmnElement="Flow_To_Diag_GW">
        <di:waypoint x="280" y="158" />
        <di:waypoint x="320" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Diag_Success_di" bpmnElement="Flow_Diag_Success">
        <di:waypoint x="370" y="158" />
        <di:waypoint x="420" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Diag_Fail_di" bpmnElement="Flow_Diag_Fail">
        <di:waypoint x="345" y="183" />
        <di:waypoint x="345" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Clarify_To_GW_di" bpmnElement="Flow_Clarify_To_GW">
        <di:waypoint x="570" y="158" />
        <di:waypoint x="620" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Proceed_Fix_di" bpmnElement="Flow_Proceed_Fix">
        <di:waypoint x="670" y="158" />
        <di:waypoint x="720" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Decline_Fix_di" bpmnElement="Flow_Decline_Fix">
        <di:waypoint x="645" y="183" />
        <di:waypoint x="645" y="250" />
        <di:waypoint x="1238" y="250" />
        <di:waypoint x="1238" y="176" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fix_To_GW_di" bpmnElement="Flow_Fix_To_GW">
        <di:waypoint x="870" y="158" />
        <di:waypoint x="920" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fix_OK_di" bpmnElement="Flow_Fix_OK">
        <di:waypoint x="970" y="158" />
        <di:waypoint x="1020" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fix_Fail_di" bpmnElement="Flow_Fix_Fail">
        <di:waypoint x="945" y="183" />
        <di:waypoint x="945" y="268" />
        <di:waypoint x="363" y="268" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_To_End_di" bpmnElement="Flow_To_End">
        <di:waypoint x="1170" y="158" />
        <di:waypoint x="1220" y="158" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
