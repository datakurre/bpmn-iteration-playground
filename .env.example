PI_EXECUTABLE=node_modules/.bin/pi
PI_TIMEOUT_SECONDS=1800
# Optional: directory copied into each new instance workspace as a starting point.
# It is never the agent's working directory -- agents always run in their own
# per-instance workspace so concurrent runs cannot collide.
# PI_WORKDIR=/path/to/template-repo
PI_OFFLINE=1
# Allow a failed real Pi run to silently retry with scripts/pi-demo.
# Off by default: fabricated agent results must never reach BPMN gateways.
PI_ALLOW_DEMO_FALLBACK=0
PI_PROVIDER=opencode-go
PI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://opencode.ai/go/v1
OPENCODE_ZEN_API_KEY=
OPENCODE_GO_API_KEY=
OPENAI_API_KEY=
ADMIN_TOKEN=secret-admin-token
API_KEYS=view-key:viewer,op-key:operator,adm-key:admin
LOG_LEVEL=INFO
