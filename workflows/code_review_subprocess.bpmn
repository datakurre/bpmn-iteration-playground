<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_Sub" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="code_review_subprocess" name="Code Review Subprocess" isExecutable="true">
    <bpmn:documentation>Reusable code review subprocess executed as a Call Activity.</bpmn:documentation>
    <bpmn:startEvent id="Sub_Start" name="Start Review">
      <bpmn:outgoing>Sub_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Sub_Flow_1" sourceRef="Sub_Start" targetRef="Sub_Task_Review" />
    <bpmn:serviceTask id="Sub_Task_Review" name="Subprocess AI Review">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="harness_type" value="pi_agent" />
          <camunda:property name="agent_role" value="code_reviewer" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Sub_Flow_1</bpmn:incoming>
      <bpmn:outgoing>Sub_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Sub_Flow_2" sourceRef="Sub_Task_Review" targetRef="Sub_GW_Check" />
    <bpmn:exclusiveGateway id="Sub_GW_Check" name="Review OK?">
      <bpmn:incoming>Sub_Flow_2</bpmn:incoming>
      <bpmn:outgoing>Sub_Flow_Success</bpmn:outgoing>
      <bpmn:outgoing>Sub_Flow_Fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Sub_Flow_Success" name="Success" sourceRef="Sub_GW_Check" targetRef="Sub_End">
      <bpmn:conditionExpression>agent_status == 'success'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Sub_Flow_Fail" name="Failed" sourceRef="Sub_GW_Check" targetRef="Sub_End_Fail">
      <bpmn:conditionExpression>agent_status != 'success'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Sub_End" name="Review Finished">
      <bpmn:incoming>Sub_Flow_Success</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Sub_End_Fail" name="Review Failed">
      <bpmn:incoming>Sub_Flow_Fail</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Sub">
    <bpmndi:BPMNPlane id="BPMNPlane_Sub" bpmnElement="code_review_subprocess">
      <bpmndi:BPMNShape id="Sub_Start_di" bpmnElement="Sub_Start">
        <dc:Bounds x="180" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_Task_Review_di" bpmnElement="Sub_Task_Review">
        <dc:Bounds x="270" y="138" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_GW_Check_di" bpmnElement="Sub_GW_Check" isMarkerVisible="true">
        <dc:Bounds x="440" y="153" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_End_di" bpmnElement="Sub_End">
        <dc:Bounds x="550" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_End_Fail_di" bpmnElement="Sub_End_Fail">
        <dc:Bounds x="550" y="240" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Sub_Flow_1_di" bpmnElement="Sub_Flow_1">
        <di:waypoint x="216" y="178" />
        <di:waypoint x="270" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Sub_Flow_2_di" bpmnElement="Sub_Flow_2">
        <di:waypoint x="400" y="178" />
        <di:waypoint x="440" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Sub_Flow_Success_di" bpmnElement="Sub_Flow_Success">
        <di:waypoint x="490" y="178" />
        <di:waypoint x="550" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Sub_Flow_Fail_di" bpmnElement="Sub_Flow_Fail">
        <di:waypoint x="465" y="203" />
        <di:waypoint x="465" y="258" />
        <di:waypoint x="550" y="258" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
