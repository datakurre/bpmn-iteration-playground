<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="contract_review" name="Contract Review" isExecutable="true">
    <bpmn:documentation>AI-powered contract clause extraction with human compliance review.</bpmn:documentation>
    <bpmn:startEvent id="StartEvent_1" name="Receive Contract">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="ServiceTask_Extract" />
    <bpmn:serviceTask id="ServiceTask_Extract" name="Extract Clauses">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="harness_type" value="pi_agent" />
          <camunda:property name="agent_role" value="contract_analyst" />
        </camunda:properties>
        <camunda:inputOutput>
          <camunda:inputParameter name="contract">${contract}</camunda:inputParameter>
          <camunda:outputParameter name="extract_status">${status}</camunda:outputParameter>
          <camunda:outputParameter name="extract_summary">${summary}</camunda:outputParameter>
          <camunda:outputParameter name="extract_findings">${findings}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="ServiceTask_Extract" targetRef="Gateway_Agent_Check" />
    <bpmn:exclusiveGateway id="Gateway_Agent_Check" name="Agent Success?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Success</bpmn:outgoing>
      <bpmn:outgoing>Flow_Failure</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Success" name="Success" sourceRef="Gateway_Agent_Check" targetRef="ServiceTask_Review">
      <bpmn:conditionExpression>extract_status == 'success'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Failure" name="Failure" sourceRef="Gateway_Agent_Check" targetRef="ServiceTask_Failure_Review">
      <bpmn:conditionExpression>extract_status != 'success'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="ServiceTask_Failure_Review" name="Review Agent Failure">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="failure_reason" label="Failure Reason" type="string" />
          <camunda:formField id="resolution" label="Resolution Notes" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Failure</bpmn:incoming>
      <bpmn:outgoing>Flow_Failure_Resolve</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Failure_Resolve" sourceRef="ServiceTask_Failure_Review" targetRef="EndEvent_1" />
    <bpmn:userTask id="ServiceTask_Review" name="Review Compliance">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="decision" label="Decision" type="string" />
          <camunda:formField id="notes" label="Notes" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Success</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="ServiceTask_Review" targetRef="EndEvent_1" />
    <bpmn:endEvent id="EndEvent_1" name="Contract Reviewed">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_Failure_Resolve</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_contract_review">
    <bpmndi:BPMNPlane id="BPMNPlane_contract_review" bpmnElement="contract_review">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_Extract_di" bpmnElement="ServiceTask_Extract">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Agent_Check_di" bpmnElement="Gateway_Agent_Check" isMarkerVisible="true">
        <dc:Bounds x="350" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_Review_di" bpmnElement="ServiceTask_Review">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="657" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_Failure_Review_di" bpmnElement="ServiceTask_Failure_Review">
        <dc:Bounds x="475" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="350" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Success_di" bpmnElement="Flow_Success">
        <di:waypoint x="400" y="70" />
        <di:waypoint x="475" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Failure_di" bpmnElement="Flow_Failure">
        <di:waypoint x="375" y="95" />
        <di:waypoint x="375" y="210" />
        <di:waypoint x="475" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="575" y="70" />
        <di:waypoint x="657" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Failure_Resolve_di" bpmnElement="Flow_Failure_Resolve">
        <di:waypoint x="575" y="210" />
        <di:waypoint x="675" y="210" />
        <di:waypoint x="675" y="88" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
