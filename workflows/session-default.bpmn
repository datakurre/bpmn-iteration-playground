<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_session_default" targetNamespace="http://graph-agent/bpmn" exporter="graph-agent" exporterVersion="0.1.0">
  <bpmn:process id="session_default" name="Default session" isExecutable="true">
    <bpmn:documentation>The out-of-the-box session graph: a single callActivity into
pi_default_loop, so a fresh session behaves exactly like plain Pi while still
being a diagram -- the callActivity, and everything before or after it, are
ordinary elements you can re-wire or splice around, without touching
pi_default_loop itself.

Point `calledElement` at a graph of your own, or extend this one (a human
gate before the loop, a deterministic check after it, ...) the same way
session-skeleton extends craft-graph.</bpmn:documentation>
    <bpmn:startEvent id="session_start" name="Prompt">
      <bpmn:outgoing>to_loop</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="to_loop" sourceRef="session_start" targetRef="agent_loop" />
    <bpmn:callActivity id="agent_loop" name="Run the Pi loop" calledElement="pi_default_loop">
      <bpmn:incoming>to_loop</bpmn:incoming>
      <bpmn:outgoing>to_end</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="to_end" sourceRef="agent_loop" targetRef="session_end" />
    <bpmn:endEvent id="session_end" name="Done">
      <bpmn:incoming>to_end</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_session_default">
    <bpmndi:BPMNPlane id="BPMNPlane_session_default" bpmnElement="session_default">
      <bpmndi:BPMNShape id="session_start_di" bpmnElement="session_start">
        <dc:Bounds x="57" y="52" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="30" y="96" width="90" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="agent_loop_di" bpmnElement="agent_loop">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="session_end_di" bpmnElement="session_end">
        <dc:Bounds x="357" y="52" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="330" y="96" width="90" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="to_loop_di" bpmnElement="to_loop">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="to_end_di" bpmnElement="to_end">
        <di:waypoint x="275" y="70" />
        <di:waypoint x="357" y="70" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <!-- ga:modelHash:7bfebde9265ab0c27bfc7269bbd1f6df48e1ae45801678451c4af8156a3a6fe6 -->
</bpmn:definitions>