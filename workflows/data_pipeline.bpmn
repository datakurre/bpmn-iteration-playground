<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_DataPipeline" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="data_pipeline" name="Data Processing Pipeline" isExecutable="true">
    <bpmn:documentation>Three-stage sequential data pipeline: ingest, transform, validate — each executed by a specialised AI agent, with human sign-off at the end.</bpmn:documentation>
    <bpmn:startEvent id="Start_Data" name="Data Source Ready">
      <bpmn:outgoing>Flow_To_Ingest</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_To_Ingest" sourceRef="Start_Data" targetRef="Task_Ingest" />
    <bpmn:serviceTask id="Task_Ingest" name="Ingest Data">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="harness_type" value="pi_agent" />
          <camunda:property name="agent_role" value="data_engineer" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Ingest</bpmn:incoming>
      <bpmn:outgoing>Flow_Ingest_GW</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Ingest_GW" sourceRef="Task_Ingest" targetRef="GW_Ingest" />
    <bpmn:exclusiveGateway id="GW_Ingest" name="Ingest OK?">
      <bpmn:incoming>Flow_Ingest_GW</bpmn:incoming>
      <bpmn:outgoing>Flow_Ingest_OK</bpmn:outgoing>
      <bpmn:outgoing>Flow_Ingest_Fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Ingest_OK" name="Success" sourceRef="GW_Ingest" targetRef="Task_Transform">
      <bpmn:conditionExpression>agent_status == 'success'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Ingest_Fail" name="Failed" sourceRef="GW_Ingest" targetRef="Task_Ingest_Fix">
      <bpmn:conditionExpression>agent_status != 'success'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_Transform" name="Transform &amp; Enrich">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="harness_type" value="pi_agent" />
          <camunda:property name="agent_role" value="data_transformer" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ingest_OK</bpmn:incoming>
      <bpmn:outgoing>Flow_Transform_Validate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Transform_Validate" sourceRef="Task_Transform" targetRef="Task_Validate" />
    <bpmn:serviceTask id="Task_Validate" name="Validate Output">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="harness_type" value="pi_agent" />
          <camunda:property name="agent_role" value="data_validator" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Transform_Validate</bpmn:incoming>
      <bpmn:outgoing>Flow_Validate_Signoff</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Validate_Signoff" sourceRef="Task_Validate" targetRef="Task_Signoff" />
    <bpmn:userTask id="Task_Signoff" name="Quality Sign-off">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="quality_decision" label="Quality Decision" type="string" />
          <camunda:formField id="data_notes" label="Pipeline Notes" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Validate_Signoff</bpmn:incoming>
      <bpmn:outgoing>Flow_Signoff_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Ingest_Fix" name="Fix Data Source">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="fix_action" label="Corrective Action" type="string" />
          <camunda:formField id="fix_notes" label="Details" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ingest_Fail</bpmn:incoming>
      <bpmn:outgoing>Flow_Fix_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Signoff_End" sourceRef="Task_Signoff" targetRef="End_Data" />
    <bpmn:sequenceFlow id="Flow_Fix_End" sourceRef="Task_Ingest_Fix" targetRef="End_Data" />
    <bpmn:endEvent id="End_Data" name="Pipeline Complete">
      <bpmn:incoming>Flow_Signoff_End</bpmn:incoming>
      <bpmn:incoming>Flow_Fix_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_DataPipeline">
    <bpmndi:BPMNPlane id="BPMNPlane_DataPipeline" bpmnElement="data_pipeline">
      <bpmndi:BPMNShape id="Start_Data_di" bpmnElement="Start_Data">
        <dc:Bounds x="57" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Ingest_di" bpmnElement="Task_Ingest">
        <dc:Bounds x="160" y="78" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Ingest_di" bpmnElement="GW_Ingest" isMarkerVisible="true">
        <dc:Bounds x="350" y="93" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Transform_di" bpmnElement="Task_Transform">
        <dc:Bounds x="460" y="20" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Validate_di" bpmnElement="Task_Validate">
        <dc:Bounds x="660" y="20" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Signoff_di" bpmnElement="Task_Signoff">
        <dc:Bounds x="860" y="20" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Ingest_Fix_di" bpmnElement="Task_Ingest_Fix">
        <dc:Bounds x="460" y="190" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Data_di" bpmnElement="End_Data">
        <dc:Bounds x="1070" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_To_Ingest_di" bpmnElement="Flow_To_Ingest">
        <di:waypoint x="93" y="118" />
        <di:waypoint x="160" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Ingest_GW_di" bpmnElement="Flow_Ingest_GW">
        <di:waypoint x="290" y="118" />
        <di:waypoint x="350" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Ingest_OK_di" bpmnElement="Flow_Ingest_OK">
        <di:waypoint x="375" y="93" />
        <di:waypoint x="375" y="60" />
        <di:waypoint x="460" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Ingest_Fail_di" bpmnElement="Flow_Ingest_Fail">
        <di:waypoint x="375" y="143" />
        <di:waypoint x="375" y="230" />
        <di:waypoint x="460" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Transform_Validate_di" bpmnElement="Flow_Transform_Validate">
        <di:waypoint x="600" y="60" />
        <di:waypoint x="660" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Validate_Signoff_di" bpmnElement="Flow_Validate_Signoff">
        <di:waypoint x="800" y="60" />
        <di:waypoint x="860" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Signoff_End_di" bpmnElement="Flow_Signoff_End">
        <di:waypoint x="1000" y="60" />
        <di:waypoint x="1088" y="60" />
        <di:waypoint x="1088" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fix_End_di" bpmnElement="Flow_Fix_End">
        <di:waypoint x="600" y="230" />
        <di:waypoint x="1088" y="230" />
        <di:waypoint x="1088" y="136" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
