[
  {
    "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
    "name": "Shell Command",
    "id": "graph-agent.shell-task",
    "version": 1,
    "description": "A deterministic step: run a command and route on its exit status.",
    "appliesTo": ["bpmn:ServiceTask"],
    "elementType": { "value": "bpmn:ServiceTask" },
    "properties": [
      {
        "type": "Hidden",
        "value": "shell",
        "binding": { "type": "zeebe:taskDefinition", "property": "type" }
      },
      {
        "label": "Command",
        "description": "Command line to run in the workspace.",
        "type": "String",
        "binding": { "type": "zeebe:taskHeader", "key": "command" },
        "constraints": { "notEmpty": true }
      },
      {
        "label": "Fail on non-zero exit",
        "type": "Boolean",
        "value": true,
        "binding": { "type": "zeebe:taskHeader", "key": "fail_on_error" }
      },
      {
        "label": "Exit status",
        "description": "Process variable the exit status is published to.",
        "type": "String",
        "value": "shell_status",
        "binding": { "type": "zeebe:output", "source": "=status" }
      }
    ]
  }
]
