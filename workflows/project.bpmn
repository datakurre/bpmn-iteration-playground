<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_Project" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="Message_Spawn_Requested" name="spawn_requested" />
  <bpmn:process id="project" name="Project" isExecutable="true">
    <bpmn:documentation>A long-running Project: stays open indefinitely and spawns a child subprocess for each spawn_requested message it receives (payload key: task_brief), while a human can close the Project explicitly from the open task. See AGENTS.md for the spawn contract.</bpmn:documentation>
    <bpmn:startEvent id="Start_Project" name="Project Started">
      <bpmn:outgoing>Flow_Project_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Project_1" sourceRef="Start_Project" targetRef="Task_Project_Open" />
    <bpmn:userTask id="Task_Project_Open" name="Project Open">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="doc_preview" label="### Project Open&#10;Spawn work by posting to /instance/{id}/message/spawn_requested with a task_brief payload. Submit this task to close the Project." type="markdown" />
          <camunda:formField id="close_notes" label="Closing Notes" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Project_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Project_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Project_2" sourceRef="Task_Project_Open" targetRef="End_Project_Closed" />
    <bpmn:endEvent id="End_Project_Closed" name="Project Closed">
      <bpmn:incoming>Flow_Project_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Spawn" name="Spawn Child Task" triggeredByEvent="true">
      <bpmn:startEvent id="Spawn_Start" name="Spawn Requested">
        <bpmn:outgoing>Flow_Spawn_1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_Spawn" messageRef="Message_Spawn_Requested" />
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="Flow_Spawn_1" sourceRef="Spawn_Start" targetRef="Task_Child_Work" />
      <bpmn:serviceTask id="Task_Child_Work" name="Execute Child Task">
        <bpmn:extensionElements>
          <camunda:properties>
            <camunda:property name="harness_type" value="pi_agent" />
            <camunda:property name="agent_role" value="project_worker" />
          </camunda:properties>
          <camunda:inputOutput>
            <camunda:inputParameter name="task_brief">${task_brief}</camunda:inputParameter>
            <camunda:outputParameter name="child_status">${status}</camunda:outputParameter>
            <camunda:outputParameter name="child_summary">${summary}</camunda:outputParameter>
            <camunda:outputParameter name="child_artifacts">${artifacts}</camunda:outputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Spawn_1</bpmn:incoming>
        <bpmn:outgoing>Flow_Spawn_2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_Spawn_2" sourceRef="Task_Child_Work" targetRef="End_Spawn" />
      <bpmn:endEvent id="End_Spawn" name="Child Task Done">
        <bpmn:incoming>Flow_Spawn_2</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Project">
    <bpmndi:BPMNPlane id="BPMNPlane_Project" bpmnElement="project">
      <bpmndi:BPMNShape id="Start_Project_di" bpmnElement="Start_Project">
        <dc:Bounds x="50" y="140" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Project_Open_di" bpmnElement="Task_Project_Open">
        <dc:Bounds x="140" y="118" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Project_Closed_di" bpmnElement="End_Project_Closed">
        <dc:Bounds x="340" y="140" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Project_1_di" bpmnElement="Flow_Project_1">
        <di:waypoint x="86" y="158" />
        <di:waypoint x="140" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Project_2_di" bpmnElement="Flow_Project_2">
        <di:waypoint x="290" y="158" />
        <di:waypoint x="340" y="158" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Spawn_di" bpmnElement="Spawn" isExpanded="true">
        <dc:Bounds x="140" y="260" width="400" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Spawn_Start_di" bpmnElement="Spawn_Start">
        <dc:Bounds x="180" y="322" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Child_Work_di" bpmnElement="Task_Child_Work">
        <dc:Bounds x="270" y="300" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Spawn_di" bpmnElement="End_Spawn">
        <dc:Bounds x="460" y="322" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Spawn_1_di" bpmnElement="Flow_Spawn_1">
        <di:waypoint x="216" y="340" />
        <di:waypoint x="270" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Spawn_2_di" bpmnElement="Flow_Spawn_2">
        <di:waypoint x="410" y="340" />
        <di:waypoint x="460" y="340" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
