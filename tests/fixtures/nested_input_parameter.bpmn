<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_NestedInputParameter" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="nested_input_parameter" name="Nested Input Parameter" isExecutable="true">
    <bpmn:documentation>Fixture: a service task whose camunda:inputParameter reads a nested path -- proves resolve_input() is actually wired into runner.prompt() (todo 09).</bpmn:documentation>
    <bpmn:startEvent id="Start_Nested">
      <bpmn:outgoing>Flow_Nested_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Nested_1" sourceRef="Start_Nested" targetRef="Task_Use_Plan" />
    <bpmn:serviceTask id="Task_Use_Plan" name="Use Plan">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="harness_type" value="pi_agent" />
        </camunda:properties>
        <camunda:inputOutput>
          <camunda:inputParameter name="plan_status">${plan.status}</camunda:inputParameter>
          <camunda:outputParameter name="use_plan_status">${status}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Nested_1</bpmn:incoming>
      <bpmn:outgoing>Flow_Nested_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Nested_2" sourceRef="Task_Use_Plan" targetRef="End_Nested" />
    <bpmn:endEvent id="End_Nested">
      <bpmn:incoming>Flow_Nested_2</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
