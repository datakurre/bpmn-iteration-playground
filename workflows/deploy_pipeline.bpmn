<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_Deploy" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="deploy_pipeline" name="Deployment Pipeline" isExecutable="true">
    <bpmn:documentation>Orchestration pipeline with call activities for chained subprocess execution.</bpmn:documentation>
    <bpmn:startEvent id="Deploy_Start" name="Trigger Deploy">
      <bpmn:outgoing>Deploy_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Deploy_Flow_1" sourceRef="Deploy_Start" targetRef="Task_PreCheck" />
    <bpmn:serviceTask id="Task_PreCheck" name="Pre-deployment Validation">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="harness_type" value="pi_agent" />
          <camunda:property name="agent_role" value="validator" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Deploy_Flow_1</bpmn:incoming>
      <bpmn:outgoing>Deploy_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Deploy_Flow_2" sourceRef="Task_PreCheck" targetRef="GW_PreCheck" />
    <bpmn:exclusiveGateway id="GW_PreCheck" name="Pre-Check OK?">
      <bpmn:incoming>Deploy_Flow_2</bpmn:incoming>
      <bpmn:outgoing>Deploy_Flow_PreCheck_OK</bpmn:outgoing>
      <bpmn:outgoing>Deploy_Flow_PreCheck_Fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Deploy_Flow_PreCheck_OK" name="Success" sourceRef="GW_PreCheck" targetRef="Task_DeployConfirm">
      <bpmn:conditionExpression>agent_status == 'success'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Deploy_Flow_PreCheck_Fail" name="Failed" sourceRef="GW_PreCheck" targetRef="Deploy_Fail_End">
      <bpmn:conditionExpression>agent_status != 'success'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Task_DeployConfirm" name="Confirm Deployment">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="deploy_decision" label="Deploy Decision" type="string" />
          <camunda:formField id="target_environment" label="Environment" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Deploy_Flow_PreCheck_OK</bpmn:incoming>
      <bpmn:outgoing>Deploy_Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Deploy_Flow_3" sourceRef="Task_DeployConfirm" targetRef="Deploy_End" />
    <bpmn:endEvent id="Deploy_End" name="Deployment Complete">
      <bpmn:incoming>Deploy_Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Deploy_Fail_End" name="Validation Failed">
      <bpmn:incoming>Deploy_Flow_PreCheck_Fail</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Deploy">
    <bpmndi:BPMNPlane id="BPMNPlane_Deploy" bpmnElement="deploy_pipeline">
      <bpmndi:BPMNShape id="Deploy_Start_di" bpmnElement="Deploy_Start">
        <dc:Bounds x="160" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PreCheck_di" bpmnElement="Task_PreCheck">
        <dc:Bounds x="260" y="138" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_PreCheck_di" bpmnElement="GW_PreCheck" isMarkerVisible="true">
        <dc:Bounds x="440" y="153" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DeployConfirm_di" bpmnElement="Task_DeployConfirm">
        <dc:Bounds x="540" y="138" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Deploy_End_di" bpmnElement="Deploy_End">
        <dc:Bounds x="740" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Deploy_Fail_End_di" bpmnElement="Deploy_Fail_End">
        <dc:Bounds x="540" y="240" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Deploy_Flow_1_di" bpmnElement="Deploy_Flow_1">
        <di:waypoint x="196" y="178" />
        <di:waypoint x="260" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Deploy_Flow_2_di" bpmnElement="Deploy_Flow_2">
        <di:waypoint x="400" y="178" />
        <di:waypoint x="440" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Deploy_Flow_PreCheck_OK_di" bpmnElement="Deploy_Flow_PreCheck_OK">
        <di:waypoint x="490" y="178" />
        <di:waypoint x="540" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Deploy_Flow_PreCheck_Fail_di" bpmnElement="Deploy_Flow_PreCheck_Fail">
        <di:waypoint x="465" y="203" />
        <di:waypoint x="465" y="258" />
        <di:waypoint x="540" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Deploy_Flow_3_di" bpmnElement="Deploy_Flow_3">
        <di:waypoint x="680" y="178" />
        <di:waypoint x="740" y="178" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
