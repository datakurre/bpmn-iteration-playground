{
  "scripts": {
    "build:css": "tailwindcss -i ./src/css/styles.css -o ./app/static/tailwind.css --minify",
    "build:assets": "node scripts/build-assets.mjs",
    "build": "npm run build:assets && npm run build:css",
    "lint:templates": "node scripts/lint_templates.js && htmlhint app/templates/*.html",
    "lint": "npm run lint:templates",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bpmn-io/form-js": "^1.10.0",
    "@bpmn-io/properties-panel": "^3.49.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "bpmn-auto-layout": "^1.3.0",
    "bpmn-js": "^18.24.0",
    "bpmn-js-bpmnlint": "^0.24.0",
    "bpmn-js-create-append-anything": "^2.0.0",
    "bpmn-js-properties-panel": "^5.64.0",
    "bpmn-js-token-simulation": "^0.40.0",
    "bpmnlint": "^11.13.0",
    "camunda-bpmn-moddle": "^7.0.1",
    "diagram-js-minimap": "^5.4.1",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.8.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.5.4",
    "htmlhint": "^1.9.2",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
