<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_DocGen" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="document_generation" name="Document Generation" isExecutable="true">
    <bpmn:documentation>Iterative two-stage AI pipeline: first agent drafts a document, second agent reviews quality, then human inspects result and either approves or requests revisions to iterate.</bpmn:documentation>
    <bpmn:startEvent id="Start_Doc" name="Receive Requirements">
      <bpmn:outgoing>Flow_To_Draft</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_To_Draft" sourceRef="Start_Doc" targetRef="Task_Draft" />
    <bpmn:serviceTask id="Task_Draft" name="Draft Document">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="harness_type" value="pi_agent" />
          <camunda:property name="agent_role" value="technical_writer" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_To_Draft</bpmn:incoming>
      <bpmn:incoming>Flow_Approve_Revise</bpmn:incoming>
      <bpmn:outgoing>Flow_Draft_GW</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Draft_GW" sourceRef="Task_Draft" targetRef="GW_Draft" />
    <bpmn:exclusiveGateway id="GW_Draft" name="Draft OK?">
      <bpmn:incoming>Flow_Draft_GW</bpmn:incoming>
      <bpmn:outgoing>Flow_Draft_OK</bpmn:outgoing>
      <bpmn:outgoing>Flow_Draft_Fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Draft_OK" name="Success" sourceRef="GW_Draft" targetRef="Task_QA">
      <bpmn:conditionExpression>agent_status == 'success'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Draft_Fail" name="Failed" sourceRef="GW_Draft" targetRef="Task_Manual_Draft">
      <bpmn:conditionExpression>agent_status != 'success'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_QA" name="Quality Review Agent">
      <bpmn:extensionElements>
        <camunda:properties>
          <camunda:property name="harness_type" value="pi_agent" />
          <camunda:property name="agent_role" value="editor" />
        </camunda:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Draft_OK</bpmn:incoming>
      <bpmn:outgoing>Flow_QA_Approve</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_QA_Approve" sourceRef="Task_QA" targetRef="Task_Approve" />
    <bpmn:userTask id="Task_Approve" name="Approve Document">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="doc_preview" label="### Generated Document Preview&#10;Review the AI draft and quality assessment below." type="markdown" />
          <camunda:formField id="document_content" label="Document Content (Markdown)" type="textarea" />
          <camunda:formField id="approval" label="Approval Decision" type="string" defaultValue="approved" />
          <camunda:formField id="feedback" label="Revision Feedback (if requesting changes)" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_QA_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_Approve_GW</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Approve_GW" sourceRef="Task_Approve" targetRef="GW_Approve" />
    <bpmn:exclusiveGateway id="GW_Approve" name="Approved?">
      <bpmn:incoming>Flow_Approve_GW</bpmn:incoming>
      <bpmn:outgoing>Flow_Approve_End</bpmn:outgoing>
      <bpmn:outgoing>Flow_Approve_Revise</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Approve_End" name="Approved" sourceRef="GW_Approve" targetRef="End_Doc">
      <bpmn:conditionExpression>approval == 'approved'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Approve_Revise" name="Request Revisions" sourceRef="GW_Approve" targetRef="Task_Draft">
      <bpmn:conditionExpression>approval != 'approved'</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Task_Manual_Draft" name="Write Manually">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="manual_content" label="Document Content" type="string" />
          <camunda:formField id="draft_notes" label="Notes" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Draft_Fail</bpmn:incoming>
      <bpmn:outgoing>Flow_Manual_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Manual_End" sourceRef="Task_Manual_Draft" targetRef="End_Doc" />
    <bpmn:endEvent id="End_Doc" name="Document Published">
      <bpmn:incoming>Flow_Approve_End</bpmn:incoming>
      <bpmn:incoming>Flow_Manual_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_DocGen">
    <bpmndi:BPMNPlane id="BPMNPlane_DocGen" bpmnElement="document_generation">
      <bpmndi:BPMNShape id="Start_Doc_di" bpmnElement="Start_Doc">
        <dc:Bounds x="57" y="100" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Draft_di" bpmnElement="Task_Draft">
        <dc:Bounds x="160" y="78" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Draft_di" bpmnElement="GW_Draft" isMarkerVisible="true">
        <dc:Bounds x="350" y="93" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_QA_di" bpmnElement="Task_QA">
        <dc:Bounds x="460" y="20" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Approve_di" bpmnElement="Task_Approve">
        <dc:Bounds x="660" y="20" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Approve_di" bpmnElement="GW_Approve" isMarkerVisible="true">
        <dc:Bounds x="840" y="35" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Doc_di" bpmnElement="End_Doc">
        <dc:Bounds x="950" y="42" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Manual_Draft_di" bpmnElement="Task_Manual_Draft">
        <dc:Bounds x="460" y="180" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_To_Draft_di" bpmnElement="Flow_To_Draft">
        <di:waypoint x="93" y="118" />
        <di:waypoint x="160" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Draft_GW_di" bpmnElement="Flow_Draft_GW">
        <di:waypoint x="290" y="118" />
        <di:waypoint x="350" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Draft_OK_di" bpmnElement="Flow_Draft_OK">
        <di:waypoint x="375" y="93" />
        <di:waypoint x="375" y="60" />
        <di:waypoint x="460" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Draft_Fail_di" bpmnElement="Flow_Draft_Fail">
        <di:waypoint x="375" y="143" />
        <di:waypoint x="375" y="220" />
        <di:waypoint x="460" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_QA_Approve_di" bpmnElement="Flow_QA_Approve">
        <di:waypoint x="600" y="60" />
        <di:waypoint x="660" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approve_GW_di" bpmnElement="Flow_Approve_GW">
        <di:waypoint x="800" y="60" />
        <di:waypoint x="840" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approve_End_di" bpmnElement="Flow_Approve_End">
        <di:waypoint x="890" y="60" />
        <di:waypoint x="950" y="60" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approve_Revise_di" bpmnElement="Flow_Approve_Revise">
        <di:waypoint x="865" y="35" />
        <di:waypoint x="865" y="-30" />
        <di:waypoint x="225" y="-30" />
        <di:waypoint x="225" y="78" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Manual_End_di" bpmnElement="Flow_Manual_End">
        <di:waypoint x="600" y="220" />
        <di:waypoint x="968" y="220" />
        <di:waypoint x="968" y="78" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
